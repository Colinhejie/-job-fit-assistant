{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jfa.requirement_map/1",
  "title": "岗位要求 ↔ 个人证据映射",
  "description": "direct 必须引用已确认事实；transferable 必须写迁移逻辑；missing_evidence 不得引用已确认事实；clear_mismatch 必须给出证明不符合的事实。",
  "type": "object",
  "required": ["schema", "requirements"],
  "properties": {
    "schema": { "type": "string", "const": "jfa.requirement_map/1" },
    "job_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "requirement", "importance", "status"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^R-[0-9]{3}$" },
          "requirement": { "type": "string", "minLength": 1 },
          "importance": { "type": "string", "enum": ["must", "nice"] },
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["direct", "transferable", "missing_evidence", "clear_mismatch"]
          },
          "explanation": { "type": "string" },
          "source_section": { "type": "string" }
        }
      }
    },
    "coverage": { "type": "object" },
    "gaps": { "type": "array" },
    "open_questions": { "type": "array" },
    "issues": { "type": "array" }
  }
}
